{
  "name": "artifacts-host",
  "version": "1.3.1",
  "description": "Self-hosted publishable artifacts: POST HTML/JSX/Markdown/zip, get a public non-crawlable URL",
  "license": "MIT",
  "author": {
    "name": "Anvil Nine",
    "url": "https://anvilnine.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anvilnine/artifacts"
  },
  "keywords": [
    "self-hosted",
    "artifacts",
    "mcp",
    "claude",
    "static-hosting",
    "express",
    "pastebin"
  ],
  "type": "module",
  "main": "server.js",
  "bin": {
    "artifacts": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env server.js",
    "test": "node --test 'test/*.test.js'",
    "version": "node scripts/sync-version.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "bpmn-moddle": "^10.3.1",
    "express": "^4.22.3",
    "marked": "^15.0.0",
    "nanoid": "^5.0.9",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "aws4fetch": "1.0.20",
    "isomorphic-git": "1.38.7",
    "pg": "8.22.0"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
