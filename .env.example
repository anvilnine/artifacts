# Required. Bootstrap admin bearer token — an all-scope, break-glass key that
# always works for writes, the MCP endpoint, and minting managed API keys.
# Day-to-day, create scoped managed keys (dashboard → API keys, or the CLI) for
# CLI/MCP clients instead of sharing this one. Generate: openssl rand -hex 32
ARTIFACTS_API_KEY=

# Optional. Seed the single admin account (dashboard login) on first boot. If
# unset, the dashboard shows a one-time "Create admin account" screen instead.
# Both are checked by the same rules that screen uses, and a value either one
# refuses stops the boot and names the variable: username 3-32 chars from
# [a-zA-Z0-9._-], password at least 8 characters.
# ARTIFACTS_ADMIN_USERNAME=admin
# ARTIFACTS_ADMIN_PASSWORD=

# Recommended. Public origin used in returned artifact URLs. Also decides whether
# the session cookie is marked Secure (set an https:// origin in production).
BASE_URL=http://localhost:3000

# Listen port.
PORT=3000

# ---------------------------------------------------------------------------
# Server config defaults. These supply the starting values for GET /api/config.
# They apply only until a setting is saved through the dashboard, the CLI (frame
# only), or PUT /api/config. The first accepted PUT writes all six fields to
# config.json, and from then on the saved values win and these vars do nothing.
# Nothing is written on boot, so leaving a var unset is not the same as saving
# its default.
#
# Two things to know before you change one. Docker Compose reads this file for
# ${VAR} substitution only: docker-compose.yml passes ARTIFACTS_API_KEY and
# BASE_URL into the container and nothing else, so add any var you set here to
# its `environment:` block too. And .github/workflows/smoke.sh asserts the
# shipped defaults, so a local .env that changes one makes the suite fail.
# ---------------------------------------------------------------------------

# Viewer frame. `enabled` is the master switch, `default` applies to artifacts
# with no per-item frame value. Unset means true. Otherwise only `1` or `true`
# (any case) means true: every other value, including an empty one, means false.
# FRAME_ENABLED=true
# FRAME_DEFAULT=true

# Markdown rendering. A value outside the listed set is ignored here and the
# default applies. The same value sent to PUT /api/config is a 400 instead.
# MD_FONT=system      # system | serif | mono
# MD_WIDTH=normal     # narrow | normal | wide
# MD_SIZE=normal      # small | normal | large
# MD_THEME=auto       # auto | light | dark

# Branding for the viewer-facing shells (frame, password gate, 404 page, markdown
# and jsx pages). Unset means the built-in look, which is what the shells rendered
# before this block existed. A value this build refuses is logged at boot and
# ignored; the same value sent to PUT /api/config is a 400 instead.
#
# html artifacts are not in that list and never will be: there is no html shell, so
# the bytes you post are the bytes served. jsx pages are built once at publish time
# and keep the branding they were built with until they are republished.
#
# A logo or favicon has to be same-origin or inline, because the chrome pages carry
# `img-src 'self' data:` and a viewer's browser blocks anything else. There is no
# static file route on this server, so a path has to be served by something in front
# of it, or by a published artifact (`/a/<slug>/logo.png`). T2.6.10 adds a real
# upload; a data: URI is the interim for a small image. SVG is refused as a data:
# URI because an SVG runs script and nothing here sanitizes one.
# BRAND_PRODUCT_NAME=Dropkiln
# BRAND_LOGO_URL=/a/brand/logo.png        # a path starting with /, or data:image/png;base64,...
# BRAND_FAVICON_URL=/a/brand/favicon.png  # same rules as BRAND_LOGO_URL
# BRAND_ACCENT_COLOR=#f0502a              # hex, or rgb()/rgba()/hsl()/hsla(), fully opaque
# BRAND_FOOTER_TEXT=Published with Dropkiln

# ---------------------------------------------------------------------------
# Storage backend. Default `local` stores artifacts as plain files (see DATA_DIR).
# Set to `s3` to store them in any S3-compatible bucket instead — this is what
# lets artifacts survive a restart on hosts that reprovision a fresh container
# with no persistent disk (Fly Machines, Cloud Run, Heroku, some PaaS tiers).
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local

# local backend only. Where artifacts are stored (plain files). Only used when
# running node directly — the Docker image always stores data at /data (mount a
# volume).
DATA_DIR=./data

# s3 backend only. The bucket MUST be private — artifacts are always served
# through this app so their security headers/expiry/disable apply; a public
# bucket would bypass all of that. Works with AWS S3, Cloudflare R2, Backblaze
# B2, MinIO, DigitalOcean Spaces, Wasabi, and GCS (S3 interop).
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=my-artifacts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=            # optional key prefix within the bucket, e.g. artifacts/

# git backend only. Commits every change to a private git remote and rehydrates from it on
# boot. The remote MUST be private and there must be exactly one writer. GIT_REMOTE_URL must
# not contain credentials — use GIT_TOKEN (or GIT_USERNAME/GIT_PASSWORD) instead.
# GIT_REMOTE_URL=https://github.com/you/artifacts-store.git
# GIT_TOKEN=
# GIT_BRANCH=main
# GIT_WORK_DIR=./data/git
# GIT_AUTHOR_NAME=artifacts-host
# GIT_AUTHOR_EMAIL=artifacts@localhost

# postgres backend only. Blobs in a bytea column; survives a fresh container. Table is created
# on first boot. Set PGSSLMODE=disable for a local non-TLS server.
# DATABASE_URL=postgres://user:pass@host:5432/artifacts

# sqlite backend only. Single-file DB (built-in node:sqlite, no extra dep). Durable only if the
# file is on durable storage — like the local backend.
# SQLITE_PATH=./data/artifacts.db
